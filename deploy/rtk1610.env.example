# ENV для /etc/rtk1610/rtk-web.env (права 600, НЕ в git).
# Секреты (RTK_LOCAL_API_KEY, RTK_OWNER_TOKEN) добавляются на VPS отдельно.
RTK_HOST=127.0.0.1
RTK_PORT=8001
RTK_BEHIND_PROXY=1
RTK_OPEN_BROWSER=0
RTK_SKIP_KEY_CHECK=1
RTK_CHECK_NETWORK=0
RTK_MAX_SESSIONS=8
RTK_IDLE_TIMEOUT=60
RTK_CHECK_TIMEOUT=30
RTK_RATE_LIMIT_PER_MIN=10
RTK_SHARED_RAG=1
RTK_SESSION_DIR=/var/lib/rtk1610/session
RTK_LOCAL_HOST=127.0.0.1
RTK_LOCAL_PORT=8080
RTK_LOCAL_CTX=4096
RTK_LOCAL_TIMEOUT=300
RTK_LOCAL_LABEL=Qwen-2B
RTK_WEAK_LABEL=Qwen-2B
RTK_STRONG_LABEL=Qwen-9B
RTK_TUNNEL_HOST=127.0.0.1
RTK_TUNNEL_PORT=18080
RTK_AGENT_HOST=127.0.0.1
RTK_AGENT_PORT=18081
RTK_TUNNEL_SSH=user@91.188.213.252
# Ключ ПК для готовой команды в UI (подставьте свой).
RTK_TUNNEL_IDENTITY=%USERPROFILE%\.ssh\ssh-key-9896
# Папка моделей НА ПК (для скана ПК и команды агента).
RTK_PC_ROOT=e:/Models/llama
RTK_OLLAMA_PORT=11434
RTK_EMBED_TUNNEL_PORT=11435
RAG_EMBED_URL=http://127.0.0.1:11435/api/embeddings
RAG_EMBED_MODEL=nomic-embed-text-v2-moe
RAG_EMBED_DIM=768
RAG_EMBED_TIMEOUT=120
RAG_REWRITE=0
RAG_RERANK=none
RTK_RAG_DOCS_DIR=/opt/rtk1610
